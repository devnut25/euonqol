FROM node:20-alpine AS builder

WORKDIR /app

# Copia solo package files per cache optimization
COPY package*.json ./
RUN npm ci

COPY . .

RUN npm run build

# Server Nginx per servire i file
FROM nginx:alpine

COPY --from=builder /app/dist /usr/share/nginx/html
COPY docker/nginx.conf /etc/nginx/conf.d/default.conf
# NB: app.conf e blocklist contengono direttive di server/location → vanno incluse
# (da nginx.conf, https.conf e app.conf), NON messe in conf.d/
COPY docker/app.conf /etc/nginx/app.conf
COPY docker/blocklist.conf /etc/nginx/blocklist.conf
# Server HTTPS, attivato da 30-https.sh solo con FRONTEND_TLS=on
COPY docker/https.conf /etc/nginx/https.conf
COPY docker/30-https.sh /docker-entrypoint.d/30-https.sh

# Pulizia dei log dei tentativi bloccati (retention 7 giorni) gestita da busybox crond
# dentro questo stesso container: la crontab è il punto unico dove leggere/cambiare la regola.
COPY docker/log-cleanup.crontab /etc/crontabs/root
COPY docker/40-blocked-logs.sh /docker-entrypoint.d/40-blocked-logs.sh
# chmod nell'immagine: il bit di esecuzione non sopravvive in modo affidabile a Windows/git,
# e la entrypoint di nginx ignora gli script di /docker-entrypoint.d/ non eseguibili
RUN chmod +x /docker-entrypoint.d/40-blocked-logs.sh /docker-entrypoint.d/30-https.sh

# Esponi porta 80 (e 443, in ascolto solo con FRONTEND_TLS=on)
EXPOSE 80 443

# Healthcheck per Docker. 127.0.0.1 e non localhost: nel container localhost
# risolve prima su ::1, dove nginx non ascolta (listen 80 e' solo IPv4).
HEALTHCHECK --interval=30s --timeout=3s --start-period=5s --retries=3 \
  CMD wget --quiet --tries=1 --spider http://127.0.0.1/ || exit 1

CMD ["nginx", "-g", "daemon off;"]
