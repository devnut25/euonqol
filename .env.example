# Project Configuration
COMPOSE_PROJECT_NAME=project-name
NODE_ENV=development

# Database

# Interruttore del database:
#   local    (default) il container postgres viene avviato dal compose,
#            dietro il profilo `localdb`. DB_HOST viene ignorato.
#   external il compose NON avvia postgres e si collega a DB_HOST.
# E' l'unica fonte di verita': il Makefile ne deriva profilo e DB_HOST.
DB_MODE=local

# Host del database, usato solo con DB_MODE=external. Se il PostgreSQL gira
# sulla macchina host e non su una VM raggiungibile in rete, usare
# `host.docker.internal` (i compose lo definiscono anche su Linux, con
# DB_HOST_IP vuoto).
DB_HOST=
# IP di DB_HOST, solo con DB_MODE=external quando il nome si risolve unicamente
# dall'/etc/hosts della macchina Docker (i container non lo ereditano): lo
# aggiunge al loro /etc/hosts, e DB_HOST resta il nome del certificato per
# verify-full. Vuoto = risoluzione normale.
DB_HOST_IP=
DB_PORT=5432
# init.sql contiene `\c euonqol;`: il database deve chiamarsi cosi', anche
# quando e' esterno.
DB_NAME=euonqol
DB_USER=euonqol_user
# Versione dell'immagine postgres: il server con DB_MODE=local e il client psql
# di db-schemas/db-init/`make psql`. Con un database esterno va allineata alla
# sua versione major. Con DB_MODE=local non cambiarla su un volume esistente:
# i dati creati da una major non si aprono con un'altra.
POSTGRES_VERSION=15
# Usato solo con DB_MODE=external, con i valori di libpq: `prefer` per un
# server con certificato self-signed, `require` per Azure o per chi impone TLS,
# `verify-ca` / `verify-full` per verificare il certificato del server (serve
# DB_SSLROOTCERT). Alimenta backend, Keycloak e psql. Con DB_MODE=local resta
# `disable`, perche' il postgres in container non espone TLS.
DB_SSLMODE=disable
# Certificati TLS, solo con DB_MODE=external: percorsi sulla macchina Docker,
# come sslrootcert/sslcert/sslkey di psql. Vuoti = non usati. `make init`/`up`/
# `deploy` li copiano in .certs/<ENV> (serve openssl, per i formati richiesti
# da Keycloak e Prisma) e li montano nei container. DB_SSLCERT e DB_SSLKEY vanno
# insieme; la chiave deve essere senza passphrase.
# Esempio: DB_SSLROOTCERT=/etc/SSLcert/root.crt
DB_SSLROOTCERT=
DB_SSLCERT=
DB_SSLKEY=

# Schema PostgreSQL in cui vivono le tabelle di Keycloak. Il default e' `public`,
# quello dell'immagine. Cambiarlo su un database GIA' popolato non basta: le
# tabelle vanno spostate a mano, vedi la procedura in readMe.md.
KEYCLOAK_DB_SCHEMA=public
# Finisce dentro una connection string: caratteri come @ : / ? # vanno
# percent-encoded (@ -> %40, # -> %23, ...).
DB_PASSWORD=euonqol_password
# Utente dedicato allo schema di Keycloak, solo con DB_MODE=external quando il
# DBA ne ha creato uno (proprietario di KEYCLOAK_DB_SCHEMA). Lo usano Keycloak e
# il client Prisma del backend che legge le sue tabelle; l'app resta su DB_USER.
# `make init` gli fa concedere a DB_USER i permessi per le foreign key verso
# user_entity. Vuoti = tutto con DB_USER, come prima. La password ha gli stessi
# vincoli di DB_PASSWORD.
KEYCLOAK_DB_USER=
KEYCLOAK_DB_PASSWORD=

# Proxy HTTP per uscire su internet, per le VM senza accesso diretto. Lo usano
# il backend per le chiamate HTTPS (CAT, webhook Teams) e la build delle
# immagini (npm, apk, Prisma). Docker pull e git vanno configurati a parte sulla
# VM. Formato http://host:porta, o http://utente:password@host:porta. Vuoto =
# connessioni dirette.
OUTBOUND_PROXY=

# Limiti connessioni verso PostgreSQL (default max_connections=100, condiviso
# tra backend e Keycloak). Finiscono come ?connection_limit= nelle URL Prisma
# e come pool JDBC di Keycloak: la somma deve restare sotto max_connections.
DB_CONNECTION_LIMIT=10
KEYCLOAK_DB_CONNECTION_LIMIT=5
KC_DB_POOL_MAX_SIZE=20
# Pool `pg` del backend (query raw, es. OTP).
DB_POOL_MAX=10

# Keycloack
KEYCLOAK_PORT=
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=testadmin123
# URL browser-facing di Keycloak (usato per redirectUris admin console). In staging impostare il dominio reale;
# in prod Keycloak e' raggiungibile solo da localhost (tunnel SSH), quindi resta http://localhost:8080.
KEYCLOAK_URL_PUBLIC=http://localhost:8080
# Solo prod: interfaccia dell'host su cui si pubblica la porta di Keycloak. Default 127.0.0.1, la console
# admin si apre con un tunnel SSH (vedi readMe). 0.0.0.0 la espone a tutti, come prima.
KEYCLOAK_BIND=
# UUID del realm creato da init-keycloak.sh. Su un'installazione esistente deve
# coincidere con l'id del realm gia' presente in Keycloak.
KEYCLOAK_REALM_ID=cc2ec4d2-c6f0-4296-90e7-d0be1de23390
# Secret del client `euonqol-backend`: init-keycloak.sh lo imposta alla creazione
# del realm, il backend lo usa per parlare con Keycloak. Su un'installazione
# esistente va messo il valore gia' configurato sul client. Nuovo valore:
# openssl rand -base64 24
KEYCLOAK_CLIENT_SECRET=
# Client pubblico del frontend: solo i suoi eventi LOGIN (login completati dopo
# l'OTP) alimentano "Ultimo accesso". Vuoto = euonqol-frontend.
KEYCLOAK_CLIENT_FRONTEND_ID=
# Client usato solo per verificare le credenziali prima dell'OTP. Lo stesso valore
# arriva a keycloak-setup (che lo crea) e al backend (che lo usa). Vuoto =
# euonqol-credentials-check. Vedi setup/keycloak/README-credentials-check-client.md
KEYCLOAK_CLIENT_CREDENTIALS_CHECK_ID=

# Keycloack - User Admin
ADMIN_USERNAME=Admin
ADMIN_EMAIL=davide.rossi@devnut.it
ADMIN_PASSWORD=Test123!
ADMIN_FIRSTNAME=Davide
ADMIN_LASTNAME=Rossi
ADMIN_TYPE=admin
ADMIN_IS_ACTIVE=true

# Email
EMAIL_HOST=
EMAIL_PORT=
EMAIL_UI_PORT=
EMAIL_FROM=
EMAIL_FROM_DISPLAY_NAME=
EMAIL_USER=
EMAIL_PASSWORD=

# Backend
BACKEND_PORT=
# URL pubblico del frontend, usato nei link delle mail (reset password,
# questionari). Obbligatorio in staging e prod.
FRONTEND_URL=http://localhost:5173
# Cifra i segreti salvati in app_settings (chiave CAT, password SMTP). Su
# un'installazione esistente NON va cambiata: i valori gia' cifrati
# diventerebbero illeggibili. Nuova chiave:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=

# CORS: origin frontend consentiti (comma-separated). Vuoto = aperto (dev)
CORS_ORIGINS=

# true se dietro reverse proxy (nginx/LB) — necessario per IP corretto nel rate limiter.
# In staging/prod va a true: davanti al backend c'e' sempre nginx, e con false tutti
# gli utenti condividono un unico contatore (l'IP del container nginx).
TRUST_PROXY=false

# Richieste API consentite per IP ogni 15 minuti (pubbliche e admin). Vuoto = 300 in
# production, 3000 altrove. Un questionario da 100 domande costa fino a ~250
# richieste e i pazienti sulla stessa rete (NAT) condividono il limite: 5000 copre
# ~20 pazienti contemporanei per rete. nginx limita comunque a 10 r/s per IP.
API_RATE_LIMIT=

# Frontend
FRONTEND_PORT=
# HTTPS su nginx (staging, test, prod): `on` accende il server sulla 443 e fa rimandare la porta 80
# su HTTPS; `off` (default) lascia solo HTTP, come prima. Con `on` servono certificato (con gli
# intermedi, fullchain) e chiave senza passphrase: percorsi sulla macchina Docker, che `make
# up`/`deploy` copiano in .certs/<ENV>-web. Dopo un rinnovo del certificato: vedi readMe.
FRONTEND_TLS=off
FRONTEND_TLS_CERT=
FRONTEND_TLS_KEY=
FRONTEND_HTTPS_PORT=443

# CAT (Computer Adaptive Testing)
CAT_API_URL=https://cat.eortc.org/api
CAT_API_KEY=

# Istituto (Settings > Institute): letti SOLO al primo avvio del backend, per
# creare l'istituto. Nome, indirizzo, città e paese sono obbligatori: se ne manca
# anche uno l'istituto non viene creato e si compila dalla pagina Settings. Le
# note e il logo si impostano solo dalla pagina.
INSTITUTE_NAME=
INSTITUTE_ADDRESS=
INSTITUTE_CITY=
INSTITUTE_COUNTRY=
INSTITUTE_REFERENT_NAME=
INSTITUTE_EMAIL=
INSTITUTE_PHONE=

# Scheduler (set to true in staging/prod; false in local dev)
ENABLE_SCHEDULER=false

# Notifiche errori su Teams (usate solo da docker-compose.staging.yaml / .prod.yaml:
# docker-compose.dev.yaml ha NODE_ENV hardcoded a 'development', che disattiva sempre l'invio)
TEAMS_WEBHOOK_URL=
TEAMS_NOTIFICATIONS_ENABLED=true
TEAMS_NOTIFY_MIN_STATUS=500
TEAMS_NOTIFY_THROTTLE_MS=300000
