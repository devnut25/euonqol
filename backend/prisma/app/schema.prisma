/// Storico invii/errori email per assignment: un assignment puo' ricevere piu' reminder
/// in giorni diversi, ognuno con esito diverso (sent/failed/bounced) - una singola colonna
/// sull'assignment sovrascriverebbe la storia.
model assignment_email_logs {
  id            Int                                      @id @default(autoincrement())
  assignment_id Int
  status        String                                   @db.VarChar(20)
  error_message String?
  attempted_at  DateTime                                 @default(now()) @db.Timestamptz(6)
  assignment    survey_questionnaire_patients_assignment @relation(fields: [assignment_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([assignment_id], map: "idx_email_log_assignment")
  @@schema("euonqol")
}

/// Log di osservabilita' per le esecuzioni dei job dello scheduler (non una coda job:
/// niente worker/retry dietro, serve solo a vedere a posteriori quante mail sono state
/// processate/fallite per ogni tick del cron).
model scheduler_job_runs {
  id              Int       @id @default(autoincrement())
  job_name        String    @db.VarChar(50)
  started_at      DateTime  @default(now()) @db.Timestamptz(6)
  finished_at     DateTime? @db.Timestamptz(6)
  total_due       Int       @default(0)
  sent_count      Int       @default(0)
  failed_count    Int       @default(0)
  remaining_count Int       @default(0)
  error           String?

  @@index([job_name, started_at], map: "idx_job_runs_name_started")
  @@schema("euonqol")
}

