// Questo schema copre SOLO `euonqol`. Le tabelle di Keycloak non vanno rispecchiate
// qui: Prisma non accetta env() in `schemas` ne' in @@schema(...), quindi averle
// significherebbe inchiodare il nome dello schema di Keycloak (configurabile con
// KEYCLOAK_DB_SCHEMA) dentro un file che Prisma riscrive.
//
// Le colonne created_by / sent_by / uploaded_by / user_id restano stringhe semplici,
// senza relazione verso user_entity; i dati dell'utente li aggancia
// src/services/keycloakUserRefs.ts leggendo dal client Keycloak.
//
// ATTENZIONE: `prisma db pull` reintroduce i 90 modelli Keycloak e le relazioni,
// perche' le foreign key esistono ancora nel database. Vanno ritolte a mano.

generator client {
  provider      = "prisma-client-js"
  output        = "../../src/generated/app"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("APP_DATABASE_URL")
  schemas  = ["euonqol"]
}

model eu_countries {
  id                                       Int                                        @id @default(autoincrement())
  language                                 String                                     @db.VarChar(45)
  original_lang                            String                                     @db.VarChar(45)
  alphabet                                 String                                     @db.VarChar(45)
  answer_option_i18n                       answer_option_i18n[]
  cat_item_bank_scale_preambles            cat_item_bank_scale_preambles[]
  cat_questions                            cat_questions[]
  feedback_answers                         feedback_answers[]
  feedback_question_translations           feedback_question_translations[]
  kit_version_files                        kit_version_files[]
  privacy_policies                         privacy_policies[]
  responses                                responses[]
  socio_demo_answers                       socio_demo_answers[]
  socio_demo_questions                     socio_demo_questions[]
  static_questions                         static_questions[]
  survey_closing_messages                  survey_closing_messages[]
  survey_eligibility_question_translations survey_eligibility_question_translations[]
  survey_presentations                     survey_presentations[]
  assignment_email_languages               survey_questionnaire_patients_assignment[] @relation("assignment_email_language")
  survey_study_info_sheets                 survey_study_info_sheets[]
  email_templates                          surveys_questionnaires_email_templates[]

  @@schema("euonqol")
}

model users {
  id             Int       @id @default(autoincrement())
  username       String    @unique @db.VarChar(255)
  password_hash  String    @db.VarChar(255)
  email          String    @unique @db.VarChar(255)
  user_type      String    @db.VarChar(50)
  first_access   Boolean?  @default(true)
  institute_name String?   @db.VarChar(255)
  is_active      Boolean?  @default(true)
  created_at     DateTime? @default(now()) @db.Timestamptz(6)
  updated_at     DateTime? @default(now()) @updatedAt @db.Timestamptz(6)

  @@schema("euonqol")
}

model password_reset_tokens {
  id               Int       @id @default(autoincrement())
  keycloak_user_id String    @db.VarChar(36)
  token_hash       String    @db.VarChar(255)
  expires_at       DateTime  @db.Timestamptz(6)
  created_at       DateTime? @default(now()) @db.Timestamptz(6)

  @@index([keycloak_user_id], map: "idx_pwd_keycloak_user_id")
  @@index([expires_at], map: "idx_pwd_expires_at")
  @@schema("euonqol")
}

model user_otp {
  id               Int       @id @default(autoincrement())
  keycloak_user_id String    @db.VarChar(36)
  otp_hash         String    @db.VarChar(255)
  used             Boolean   @default(false)
  expires_at       DateTime  @db.Timestamptz(6)
  created_at       DateTime? @default(now()) @db.Timestamptz(6)

  @@index([keycloak_user_id], map: "idx_otp_keycloak_user_id")
  @@index([expires_at], map: "idx_otp_expires_at")
  @@schema("euonqol")
}

model user_sessions {
  id            Int          @id @default(autoincrement())
  user_id       String?      @db.VarChar(36)
  session_token String?      @db.VarChar(255)
  start_time    DateTime?    @default(now()) @db.Timestamptz(6)
  end_time      DateTime?    @db.Timestamptz(6)
  last_activity DateTime?    @default(now()) @db.Timestamptz(6)
  user_logs     user_logs[]

  @@schema("euonqol")
}

model user_logs {
  id          Int            @id @default(autoincrement())
  user_id     String?        @db.VarChar(36)
  session_id  Int?
  action      String         @db.VarChar(255)
  description String?
  created_at  DateTime?      @default(now()) @db.Timestamptz(6)
  session     user_sessions? @relation(fields: [session_id], references: [id], onUpdate: NoAction)

  @@schema("euonqol")
}

model patient_groups {
  id                      Int                       @id @default(autoincrement())
  name                    String                    @unique @db.VarChar(50)
  description             String?                   @db.VarChar(200)
  is_active               Boolean                   @default(true)
  created_at              DateTime?                 @default(now()) @db.Timestamptz(6)
  updated_at              DateTime?                 @default(now()) @updatedAt @db.Timestamptz(6)
  modules                 modules[]
  patient_group_questions patient_group_questions[]
  patients                patients[]
  questionnaires          questionnaires[]
  cat_item_bank_scales    cat_item_bank_scales[]

  @@schema("euonqol")
}

// Singleton row (id is constrained to 1 at the DB level) holding the identity of the
// single institution running this installation — used to brand outgoing emails/PDFs.
model institutes {
  id            Int       @id @default(autoincrement())
  name          String    @db.VarChar(255)
  address       String
  city          String    @db.VarChar(255)
  country       String    @db.VarChar(255)
  note          String?
  email         String?   @db.VarChar(255)
  phone         String?   @db.VarChar(30)
  referent_name String?   @db.VarChar(255)
  logo_url      String?
  created_at    DateTime? @default(now()) @db.Timestamptz(6)
  updated_at    DateTime? @default(now()) @updatedAt @db.Timestamptz(6)

  @@schema("euonqol")
}

// Generic key/value store for installation-wide settings that must be editable from the
// admin UI without a restart (CAT API credentials, outgoing email/SMTP config, …).
// `value` holds the encrypted ciphertext (see helpers/crypto.ts) when `is_encrypted` is true.
model app_settings {
  id           Int       @id @default(autoincrement())
  key          String    @unique @db.VarChar(120)
  value        String?
  is_encrypted Boolean   @default(false)
  updated_by   String?   @db.VarChar(36)
  created_at   DateTime? @default(now()) @db.Timestamptz(6)
  updated_at   DateTime? @default(now()) @updatedAt @db.Timestamptz(6)

  @@schema("euonqol")
}

model patients {
  id                      Int                                        @id @default(autoincrement())
  patient_id              String                                     @db.VarChar(255)
  survey_questionnaire_id Int
  group_id                Int?
  mail                    String?                                    @db.VarChar(255)
  phone_prefix            String?                                    @db.VarChar(10)
  phone                   String?                                    @db.VarChar(30)
  created_by              String?                                    @db.VarChar(36)
  created_at              DateTime?                                  @default(now()) @db.Timestamptz(6)
  updated_at              DateTime?                                  @default(now()) @updatedAt @db.Timestamptz(6)
  is_active               Boolean?                                   @default(true)
  is_anonymous            Boolean                                    @default(false)
  patient_sessions        patient_sessions[]
  group                   patient_groups?                            @relation(fields: [group_id], references: [id], onUpdate: NoAction)
  survey_questionnaire    surveys_questionnaires                     @relation(fields: [survey_questionnaire_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  survey_assignments      survey_questionnaire_patients_assignment[]

  @@unique([patient_id, survey_questionnaire_id])
  @@index([group_id], map: "idx_patients_group_id")
  @@index([survey_questionnaire_id], map: "idx_patients_sq")
  @@schema("euonqol")
}

model answer_profiles {
  id             Int              @id @default(autoincrement())
  code           String           @unique @db.VarChar(80)
  description    String?
  created_at     DateTime?        @default(now()) @db.Timestamptz(6)
  updated_at     DateTime?        @default(now()) @updatedAt @db.Timestamptz(6)
  answer_options answer_options[]
  questions      questions[]

  @@schema("euonqol")
}

model answer_options {
  id                 Int                  @id @default(autoincrement())
  answer_profile_id  Int
  value              Int
  option_code        String?              @db.VarChar(40)
  display_order      Int
  is_selectable      Boolean              @default(true)
  created_at         DateTime?            @default(now()) @db.Timestamptz(6)
  updated_at         DateTime?            @default(now()) @updatedAt @db.Timestamptz(6)
  answer_option_i18n answer_option_i18n[]
  answer_profile     answer_profiles      @relation(fields: [answer_profile_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  responses          responses[]

  @@unique([answer_profile_id, value])
  @@index([answer_profile_id], map: "idx_answer_options_profile")
  @@schema("euonqol")
}

model answer_option_i18n {
  id               Int            @id @default(autoincrement())
  answer_option_id Int
  language_id      Int
  label            String
  created_at       DateTime?      @default(now()) @db.Timestamptz(6)
  updated_at       DateTime?      @default(now()) @updatedAt @db.Timestamptz(6)
  answer_option    answer_options @relation(fields: [answer_option_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  language         eu_countries   @relation(fields: [language_id], references: [id], onUpdate: NoAction)

  @@unique([answer_option_id, language_id])
  @@index([language_id], map: "idx_answer_i18n_lang")
  @@schema("euonqol")
}

model kit_versions {
  id                Int                 @id @default(autoincrement())
  name              String              @unique @db.VarChar(120)
  is_active         Boolean             @default(true)
  created_by        String?             @db.VarChar(36)
  created_at        DateTime?           @default(now()) @db.Timestamptz(6)
  updated_at        DateTime?           @default(now()) @updatedAt @db.Timestamptz(6)
  kit_version_files kit_version_files[]
  modules           modules[]
  questions         questions[]

  @@schema("euonqol")
}

model kit_version_files {
  id             Int          @id @default(autoincrement())
  kit_version_id Int
  question_kind  String       @db.VarChar(20)
  file_name      String       @db.VarChar(255)
  language_id    Int
  uploaded_by    String?      @db.VarChar(36)
  uploaded_at    DateTime?    @default(now()) @db.Timestamptz(6)
  kit_version    kit_versions @relation(fields: [kit_version_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  language       eu_countries @relation(fields: [language_id], references: [id], onUpdate: NoAction)

  @@unique([kit_version_id, question_kind, language_id], name: "unique_kit_file", map: "unique_kit_file")
  @@index([kit_version_id, question_kind], map: "idx_kvf_kit_kind")
  @@schema("euonqol")
}

model cat_settings {
  id                   Int                    @id @default(autoincrement())
  name                 String                 @db.VarChar(80)
  description          String?
  setting_key          String?                @db.VarChar(120)
  api_configuration    Json?
  created_at           DateTime?              @default(now()) @db.Timestamptz(6)
  updated_at           DateTime?              @default(now()) @updatedAt @db.Timestamptz(6)
  modules               modules[]
  cat_item_bank_scales cat_item_bank_scales[]
  cat_module_sessions  cat_module_sessions[]

  @@index([setting_key], map: "idx_cat_settings_setting_key")
  @@schema("euonqol")
}

model cat_item_banks {
  id                   Int                    @id @default(autoincrement())
  name                 String                 @unique @db.VarChar(120)
  description          String?
  is_active            Boolean                @default(true)
  created_by           String?                @db.VarChar(36)
  created_at           DateTime?              @default(now()) @db.Timestamptz(6)
  updated_at           DateTime?              @default(now()) @updatedAt @db.Timestamptz(6)
  questions            questions[]
  modules              modules[]
  cat_item_bank_scales cat_item_bank_scales[]

  @@schema("euonqol")
}

model cat_item_bank_scales {
  id               Int            @id @default(autoincrement())
  cat_item_bank_id Int
  scale_code       String         @db.VarChar(50)
  display_name     String?        @db.VarChar(120)
  patient_group_id Int
  cat_setting_id   Int
  created_at       DateTime?      @default(now()) @db.Timestamptz(6)
  updated_at       DateTime?      @default(now()) @updatedAt @db.Timestamptz(6)
  cat_item_bank    cat_item_banks @relation(fields: [cat_item_bank_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  cat_setting      cat_settings   @relation(fields: [cat_setting_id], references: [id], onDelete: Restrict, onUpdate: NoAction)
  patient_group    patient_groups @relation(fields: [patient_group_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  preambles        cat_item_bank_scale_preambles[]

  @@unique([cat_item_bank_id, scale_code, patient_group_id], map: "cat_item_bank_scales_bank_scale_group_key")
  @@index([cat_setting_id], map: "idx_cibs_cat_setting")
  @@index([patient_group_id], map: "idx_cibs_patient_group")
  @@schema("euonqol")
}

// Per-language preamble text for a CAT scale mapping, shown fixed for the whole
// CAT session of that scale — imported from the "Questions" sheet's "Pramble"
// column (same value repeated on every row of that ScaleCode/language), NOT
// from static_questions (which is for genuinely static questions, unrelated).
model cat_item_bank_scale_preambles {
  id                     Int                  @id @default(autoincrement())
  cat_item_bank_scale_id Int
  language_id            Int
  preamble               String?              @db.Text
  created_at             DateTime?            @default(now()) @db.Timestamptz(6)
  updated_at             DateTime?            @default(now()) @updatedAt @db.Timestamptz(6)
  cat_item_bank_scale    cat_item_bank_scales @relation(fields: [cat_item_bank_scale_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  language               eu_countries         @relation(fields: [language_id], references: [id], onUpdate: NoAction)

  @@unique([cat_item_bank_scale_id, language_id], map: "cat_item_bank_scale_preambles_scale_lang_key")
  @@index([cat_item_bank_scale_id, language_id], map: "idx_cibsp_scale_lang")
  @@schema("euonqol")
}

model questions {
  id                             Int                              @id @default(autoincrement())
  kit_version_id                 Int?
  cat_item_bank_id               Int?
  question_kind                  String                           @db.VarChar(20)
  question_code                  String                           @db.VarChar(50)
  answer_profile_id              Int?
  interface                      String?                          @db.VarChar(50)
  question_type                  String?                          @db.VarChar(50)
  order_position                 Int?
  scale                          String?                          @db.VarChar(50)
  direction                      String?                          @db.VarChar(50)
  score_system                   String?                          @db.VarChar(50)
  parent_qid                     String?                          @db.VarChar(50)
  operator                       String?                          @db.VarChar(20)
  value                          String?                          @db.VarChar(50)
  is_mandatory                   Boolean?
  version                        Int?
  created_by                     String?                          @db.VarChar(36)
  created_at                     DateTime?                        @default(now()) @db.Timestamptz(6)
  updated_at                     DateTime?                        @default(now()) @updatedAt @db.Timestamptz(6)
  cat_questions                  cat_questions[]
  feedback_answers               feedback_answers[]
  feedback_question_translations feedback_question_translations[]
  modules_questions              modules_questions[]
  patient_group_questions        patient_group_questions[]
  answer_profile                 answer_profiles?                 @relation(fields: [answer_profile_id], references: [id], onDelete: Restrict, onUpdate: NoAction)
  kit_version                    kit_versions?                    @relation(fields: [kit_version_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  cat_item_bank                  cat_item_banks?                  @relation(fields: [cat_item_bank_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  responses                      responses[]
  socio_demo_answers             socio_demo_answers[]
  socio_demo_questions           socio_demo_questions[]
  static_questions               static_questions[]

  @@unique([kit_version_id, question_kind, question_code])
  @@unique([cat_item_bank_id, question_kind, question_code], map: "questions_bank_kind_code_key")
  @@index([kit_version_id, question_kind], map: "idx_q_kit_kind")
  @@index([cat_item_bank_id, question_kind], map: "idx_q_bank_kind")
  @@index([answer_profile_id], map: "idx_q_answer_profile")
  @@schema("euonqol")
}

model patient_group_questions {
  id               Int            @id @default(autoincrement())
  question_id      Int
  patient_group_id Int
  created_at       DateTime?      @default(now()) @db.Timestamptz(6)
  updated_at       DateTime?      @default(now()) @updatedAt @db.Timestamptz(6)
  patient_group    patient_groups @relation(fields: [patient_group_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  question         questions      @relation(fields: [question_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([patient_group_id, question_id])
  @@index([patient_group_id], map: "idx_pgq_group")
  @@index([question_id], map: "idx_pgq_question")
  @@schema("euonqol")
}

model static_questions {
  id           Int          @id @default(autoincrement())
  question_id  Int
  cat_id       String?      @db.VarChar(50)
  language_id  Int
  head         String?
  pramble      String?
  question     String?
  created_at   DateTime?    @default(now()) @db.Timestamptz(6)
  updated_at   DateTime?    @default(now()) @updatedAt @db.Timestamptz(6)
  language     eu_countries @relation(fields: [language_id], references: [id], onUpdate: NoAction)
  question_rel questions    @relation(fields: [question_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([question_id, language_id])
  @@index([question_id, language_id], map: "idx_sq_q_lang")
  @@schema("euonqol")
}

model cat_questions {
  id           Int          @id @default(autoincrement())
  question_id  Int
  language_id  Int
  cat_id       String?      @db.VarChar(50)
  pramble      String?
  question     String?
  created_at   DateTime?    @default(now()) @db.Timestamptz(6)
  updated_at   DateTime?    @default(now()) @updatedAt @db.Timestamptz(6)
  language     eu_countries @relation(fields: [language_id], references: [id], onUpdate: NoAction)
  question_rel questions    @relation(fields: [question_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([question_id, language_id])
  @@index([question_id, language_id], map: "idx_cq_q_lang")
  @@schema("euonqol")
}

model socio_demo_questions {
  id            Int          @id @default(autoincrement())
  question_id   Int
  language_id   Int
  question_text String?
  created_at    DateTime?    @default(now()) @db.Timestamptz(6)
  updated_at    DateTime?    @default(now()) @updatedAt @db.Timestamptz(6)
  language      eu_countries @relation(fields: [language_id], references: [id], onUpdate: NoAction)
  question_rel  questions    @relation(fields: [question_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([question_id, language_id])
  @@index([question_id, language_id], map: "idx_sdq_q_lang")
  @@schema("euonqol")
}

model socio_demo_answers {
  id            Int          @id @default(autoincrement())
  question_id   Int
  language_id   Int
  answer_text   String
  answer_type   String       @db.VarChar(50)
  display_order Int
  min_value     Float?
  max_value     Float?
  created_at    DateTime?    @default(now()) @db.Timestamptz(6)
  updated_at    DateTime?    @default(now()) @updatedAt @db.Timestamptz(6)
  responses     responses[]
  language      eu_countries @relation(fields: [language_id], references: [id], onUpdate: NoAction)
  question_rel  questions    @relation(fields: [question_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([question_id], map: "idx_sda_question")
  @@index([question_id, language_id], map: "idx_sda_q_lang")
  @@index([question_id, display_order], map: "idx_sda_q_order")
  @@schema("euonqol")
}

model modules {
  id                     Int                      @id @default(autoincrement())
  kit_version_id         Int
  name                   String                   @db.VarChar(200)
  type                   String                   @db.VarChar(20)
  is_active              Boolean                  @default(true)
  group_name             String?                  @db.VarChar(120)
  patient_group_id       Int?
  cat_setting_id         Int?
  cat_item_bank_id       Int?
  created_by             String?                  @db.VarChar(36)
  created_at             DateTime?                @default(now()) @db.Timestamptz(6)
  updated_at             DateTime?                @default(now()) @updatedAt @db.Timestamptz(6)
  cat_module_sessions    cat_module_sessions[]
  cat_setting            cat_settings?            @relation(fields: [cat_setting_id], references: [id], onUpdate: NoAction)
  cat_item_bank          cat_item_banks?          @relation(fields: [cat_item_bank_id], references: [id], onDelete: Restrict, onUpdate: NoAction)
  kit_version            kit_versions             @relation(fields: [kit_version_id], references: [id], onUpdate: NoAction)
  patient_group          patient_groups?          @relation(fields: [patient_group_id], references: [id], onDelete: Restrict, onUpdate: NoAction)
  modules_questions      modules_questions[]
  questionnaires_modules questionnaires_modules[]

  @@index([kit_version_id], map: "idx_modules_kit")
  @@index([patient_group_id], map: "idx_modules_patient_group")
  @@index([cat_item_bank_id], map: "idx_modules_cat_item_bank")
  @@schema("euonqol")
}

model modules_questions {
  id          Int          @id @default(autoincrement())
  module_id   Int
  question_id Int
  position    Int
  is_active   Boolean?     @default(true)
  created_by  String?      @db.VarChar(36)
  created_at  DateTime?    @default(now()) @db.Timestamptz(6)
  updated_at  DateTime?    @default(now()) @updatedAt @db.Timestamptz(6)
  module      modules      @relation(fields: [module_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  question    questions    @relation(fields: [question_id], references: [id], onUpdate: NoAction)

  @@unique([module_id, question_id])
  @@index([module_id, position], map: "idx_mq_order")
  @@schema("euonqol")
}

model questionnaires {
  id                     Int                      @id @default(autoincrement())
  title                  String                   @db.VarChar(255)
  description            String?
  patient_group_id       Int
  type                   String                   @db.VarChar(20)
  status                 String                   @default("draft") @db.VarChar(20)
  ctt_norms_version_id   Int?
  max_completions        Int?
  created_by             String?                  @db.VarChar(36)
  created_at             DateTime?                @default(now()) @db.Timestamptz(6)
  updated_at             DateTime?                @default(now()) @updatedAt @db.Timestamptz(6)
  disabled_by_survey     Boolean                  @default(false)
  ctt_norms_version      ctt_norms_versions?      @relation(fields: [ctt_norms_version_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  patient_group          patient_groups           @relation(fields: [patient_group_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  questionnaires_modules questionnaires_modules[]
  surveys_questionnaires surveys_questionnaires[]

  @@index([patient_group_id], map: "idx_q_patient_group")
  @@index([ctt_norms_version_id], map: "idx_questionnaires_ctt_norms")
  @@schema("euonqol")
}

model questionnaires_modules {
  id               Int            @id @default(autoincrement())
  questionnaire_id Int
  module_id        Int
  position         Int
  is_active        Boolean?       @default(true)
  created_at       DateTime?      @default(now()) @db.Timestamptz(6)
  updated_at       DateTime?      @default(now()) @updatedAt @db.Timestamptz(6)
  module           modules        @relation(fields: [module_id], references: [id], onUpdate: NoAction)
