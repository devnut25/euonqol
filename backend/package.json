{
  "name": "euonqol-kit-backend",
  "version": "1.0.0",
  "description": "Backend Service of EUonQol Platform",
  "main": "index.js",
  "type": "module",
  "directories": {
    "test": "tests"
  },
  "devDependencies": {
    "@prisma/client": "^6.19.2",
    "@types/bcrypt": "^6.0.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.5",
    "@types/multer": "^1.4.13",
    "@types/node": "^22.0.0",
    "@types/nodemailer": "^7.0.1",
    "@types/pg": "^8.15.6",
    "@types/qrcode": "^1.5.6",
    "@types/qs": "^6.14.0",
    "@types/xlsx": "^0.0.35",
    "@vitest/coverage-v8": "^2.0.0",
    "prisma": "^6.19.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.9.3",
    "vitest": "^2.0.0"
  },
  "scripts": {
    "start": "tsx src/server.ts",
    "dev": "tsx --tsconfig tsconfig.json --watch src/server.ts",
    "dev:host": "tsx --tsconfig tsconfig.json --watch src/server.ts",
    "build": "tsc",
    "seed": "tsx src/services/seed/index.ts",
    "seed:foundation": "npm run seed countries && npm run seed groups && npm run seed users",
    "seed:cat-settings": "tsx src/services/seed/importCatSettings.ts",
    "seed:socio-demo": "tsx src/services/seed/importKitVersionSocioDemo.ts",
    "migrate": "tsx scripts/migrate.ts",
    "migrate:status": "tsx scripts/migrate.ts --status",
    "migrate:baseline": "tsx scripts/migrate.ts --baseline",
    "fetch:cat-settings": "node scripts/fetch-all-cat-settings.cjs",
    "test:cat-setting": "node scripts/test-fetch-cat-setting.cjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "author": "Alberto Polini",
  "license": "ISC",
  "dependencies": {
    "@types/node-cron": "^3.0.11",
    "axios": "^1.13.2",
    "bcrypt": "^6.0.0",
    "cors": "^2.8.5",
    "exceljs": "^4.4.0",
    "express": "^5.1.0",
    "express-rate-limit": "^8.6.0",
    "helmet": "^8.3.0",
    "https-proxy-agent": "^7.0.6",
    "i18next": "^25.7.1",
    "module-alias": "^2.3.4",
    "multer": "^2.0.2",
    "node-cron": "^4.2.1",
    "nodemailer": "^7.0.6",
    "pg": "^8.19.0",
    "prisma-query-enhancer": "^1.0.5",
    "qrcode": "^1.5.4",
    "qs": "^6.14.0",
    "resend": "^6.8.0",
    "tsx": "^4.21.0",
    "xlsx": "^0.18.5",
    "zod": "^4.1.13"
  }
}
