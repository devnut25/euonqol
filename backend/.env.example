FRONTEND_URL=

# CORS: origin frontend consentiti (comma-separated). Vuoto = aperto (dev)
CORS_ORIGINS=

# true se dietro reverse proxy (nginx/LB) in prod — necessario per IP corretto nel rate limiter
TRUST_PROXY=false

# Genera con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=63129faea0205e9c42154c23c15af0dd386f3cdbc4a3b2ee2e89bfcd28e75db8

# Schema in cui vivono le tabelle di Keycloak. Deve coincidere con il parametro
# ?schema= di KEYCLOAK_DATABASE_URL qui sotto e con KC_DB_SCHEMA del container Keycloak.
KEYCLOAK_DB_SCHEMA=public

# client per Keycloak
KEYCLOAK_DATABASE_URL="postgresql://euonqol_user:euonqol_password@localhost:5432/euonqol?schema=public"

# client per la tua app (schema euonqol)
APP_DATABASE_URL="postgresql://euonqol_user:euonqol_password@localhost:5432/euonqol?schema=euonqol"

# CAT esterno (cat.eortc.org) e mail di servizio: valori di fallback usati solo finché
# non vengono impostati da Settings > CAT API / Settings > Email nell'admin (salvati
# cifrati in app_settings, hanno priorità su queste env var).
CAT_API_URL=https://cat.eortc.org/api
CAT_API_KEY=
EMAIL_PROVIDER=smtp
EMAIL_FROM=noreply@euonqol.com
EMAIL_HOST=localhost
EMAIL_PORT=1025
EMAIL_SECURE=false
EMAIL_USER=
EMAIL_PASSWORD=
RESEND_API_KEY=

# Notifiche errori su Teams (Incoming Webhook del canale)
TEAMS_WEBHOOK_URL=
# false per disattivare le notifiche a prescindere dall'ambiente (default: true)
TEAMS_NOTIFICATIONS_ENABLED=true
# status code minimo che genera una notifica Teams (default: 500)
TEAMS_NOTIFY_MIN_STATUS=500
# finestra anti-spam in ms: stesso errore/endpoint non rinotificato prima che scada (default: 300000 = 5 min)
TEAMS_NOTIFY_THROTTLE_MS=300000
